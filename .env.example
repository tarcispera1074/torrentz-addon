# Server Port & Host
PORT=7000
HOST=0.0.0.0

# How long a Debrid resolve may wait for a torrent to finish processing (ms).
# After this budget the playback endpoint returns 503 + Retry-After.
DEBRID_WAIT_MS=15000

# Optional HTTP/HTTPS/SOCKS proxy for scrapers
# HTTPS_PROXY=http://127.0.0.1:8191
# NO_PROXY=localhost,127.0.0.1

# Optional FlareSolverr endpoint used when a mirror serves a Cloudflare challenge
# FLARESOLVERR_URL=http://127.0.0.1:8191

# Live integration tests only (never commit real keys)
TORBOX_API_KEY=
